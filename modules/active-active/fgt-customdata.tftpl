--===============0086047718136476635==
Content-Type: text/plain; charset="us-ascii"
MIME-Version: 1.0
Content-Transfer-Encoding: 7bit
Content-Disposition: attachment; filename="config"

config system sdn-connector
	edit AzureSDN
		set type azure
	next
end
config sys global
    set hostname "${fgt_vm_name***REMOVED***"
    set gui-theme mariner
    set allow-traffic-redirect disable
end
config vpn ssl settings
    set port 7443
end
config router static
    edit 1
        set gateway ${fgt_external_gw***REMOVED***
        set device port1
    next
    edit 2
        set dst ${vnet_network***REMOVED***
        set gateway ${fgt_internal_gw***REMOVED***
        set device port2
    next
    edit 3
        set dst 168.63.129.16 255.255.255.255
        set device port2
        set gateway ${fgt_internal_gw***REMOVED***
    next
    edit 4
        set dst 168.63.129.16 255.255.255.255
        set device port1
        set gateway ${fgt_external_gw***REMOVED***
    next
end
config system probe-response
    set http-probe-value OK
    set mode http-probe
end
config system interface
    edit port1
        set mode static
        set ip ${fgt_external_ipaddr***REMOVED***/${fgt_external_mask***REMOVED***
        set description external
        set allowaccess set allowaccess ping https ssh probe-response
    next
    edit port2
        set mode static
        set ip ${fgt_internal_ipaddr***REMOVED***/${fgt_internal_mask***REMOVED***
        set description internal
        set allowaccess set allowaccess ping https ssh probe-response
    next
end
%{ if fgt_ssh_public_key_file != "" ***REMOVED***
config system admin
    edit "${fgt_username***REMOVED***"
        set ssh-public-key1 "${trimspace(file(fgt_ssh_public_key_file))***REMOVED***"
    next
end
%{ endif ***REMOVED***
%{ if fgt_config_ha ***REMOVED***
config system ha
    set session-pickup enable
    set session-pickup-connectionless enable
    set session-pickup-nat enable
    set session-pickup-expectation enable
    set override disable
end

config system standalone-cluster
  config cluster-peer
    %{ for idx, ip in fgt_ha_peerips ~***REMOVED***
        edit ${idx + 1***REMOVED***
            set peerip ${ip***REMOVED***
            set syncvd "root"
        next
    %{ endfor ~***REMOVED***
  end
end
%{ endif ***REMOVED***
%{ if fgt_fortimanager_ip != "" ***REMOVED***
config system central-management
    set type fortimanager
    set fmg ${fgt_fortimanager_ip***REMOVED***
    set serial-number ${fgt_fortimanager_serial***REMOVED***
end
%{ endif ***REMOVED***
%{ if fgt_additional_custom_data != "" ***REMOVED*** ${ fgt_additional_custom_data ***REMOVED*** %{ endif ***REMOVED***
%{ if fgt_license_fortiflex != "" ***REMOVED***
--===============0086047718136476635==
